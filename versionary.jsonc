{
  "$schema": "https://raw.githubusercontent.com/jolars/versionary/v1/schemas/config.json",
  "version": 1,
  "review-mode": "pr",
  "release-pr-checks": "skip",
  "release-type": "simple",
  "monorepo-mode": "independent",
  "allow-stable-major": false,
  "separate-release-prs": true,
  "bootstrap-sha": "ff064bc725ed4795b164315fa74ae0178a9f91d5",
  "release-draft": false,
  "release-reference-comments": "best-effort",
  // Test and README changes alone should not require package releases.
  // Paths are relative to each package, including the registry.
  "exclude-paths": [
    "README.md",
    "test",
    "tests",
    "tests_live"
  ],
  "packages": {
    "crates/datamonger-core": {
      "release-type": "rust",
      "package-name": "datamonger-core",
      "release-draft": false
    },
    "crates/datamonger-ffi": {
      "release-type": "rust",
      "package-name": "datamonger-ffi",
      "release-draft": false
    },
    "registry": {
      "release-type": "simple",
      "package-name": "registry",
      "release-draft": true,
      "exclude-paths": [
        "releases",
        "catalog.json",
        "latest.json"
      ]
    },
    "packages/python": {
      "release-type": "python",
      "package-name": "datamonger-python"
    },
    "packages/r": {
      "release-type": "r",
      "package-name": "datamonger-r",
      "release-draft": true,
      "exclude-paths": ["cran-comments.md"]
    },
    "packages/julia": {
      "release-type": "julia",
      "package-name": "datamonger-julia",
      "release-mode": "external",
      "exclude-paths": ["tutorials"]
    },
    "packages/cli": {
      "release-type": "rust",
      "package-name": "datamonger",
      "release-draft": true,
      "exclude-paths": ["examples"]
    }
  }
}
