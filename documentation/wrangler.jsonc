{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "datamonger-docs",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "main": "./worker.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/install"]
  },
  "routes": [
    {
      "pattern": "datamonger.dev",
      "custom_domain": true
    }
  ]
}
