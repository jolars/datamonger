{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamonger.dev/spec/schema/selector-v1.schema.json",
  "title": "Datamonger strong registry selector version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "index_sha256", "index_url"],
  "properties": {
    "schema_version": {"const": 1},
    "release": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "index_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^/\\s?#]+"
    }
  }
}
