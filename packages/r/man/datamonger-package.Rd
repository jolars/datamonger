\name{datamonger-package}
\alias{datamonger}
\alias{datamonger-package}
\title{Reproducible Retrieval and Decoding of Public Research Data}
\description{
Datamonger retrieves public research datasets through immutable registry
selectors, verifies exact artifact bytes, and verifies decoded logical values
against a cross-language canonical digest. The package performs no telemetry.
}
\docType{package}
