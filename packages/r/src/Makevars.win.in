TARGET = $(subst 64,x86_64,$(subst 32,i686,$(WIN)))-pc-windows-gnu
TARGET_DIR = rust/target
STATLIB = $(TARGET_DIR)/$(TARGET)/@LIBDIR@/libdatamonger_r.a
PKG_LIBS = $(STATLIB) -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll

all: $(SHLIB) rust_clean

$(SHLIB): $(STATLIB)

.PHONY: $(STATLIB)
$(STATLIB):
	if test "@VENDORED@" = true; then \
		tar xf rust/vendor.tar.xz; \
		mkdir -p .cargo; \
		cp rust/vendor-config.toml .cargo/config.toml; \
	fi
	mkdir -p .cargo/libgcc_mock
	$(AR) cr .cargo/libgcc_mock/libgcc_eh.a
	@CARGO_HOME@ LIBRARY_PATH="$(LIBRARY_PATH);$(CURDIR)/.cargo/libgcc_mock" RUSTC=@RUSTC@ @CARGO@ @CORE_PATCH@ build --manifest-path rust/Cargo.toml --target-dir $(TARGET_DIR) --target $(TARGET) --lib @LOCKED@ @OFFLINE@ -j 2 @PROFILE@

rust_clean: $(SHLIB)
	rm -rf .cargo vendor @CLEAN_TARGET@

clean:
	rm -rf $(SHLIB) $(OBJECTS) $(TARGET_DIR) .cargo vendor
