{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamonger.dev/spec/schema/release-source-v1.schema.json",
  "title": "Datamonger release authoring source version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "sequence",
    "repository",
    "tag",
    "manifests",
    "defaults"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "release": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "manifests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relativePath"}
    },
    "defaults": {
      "type": "array",
      "items": {"$ref": "index-v1.schema.json#/$defs/identity"}
    },
    "errata": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relativePath"}
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
